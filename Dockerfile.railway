# Imagen para ejecutar PyPSA-Eur en Railway como job batch
FROM ghcr.io/prefix-dev/pixi:0.81.0

RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates bash git && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

# 1) Entorno (capa cacheable): solo pixi.toml / pixi.lock
COPY pixi.toml pixi.lock ./
RUN pixi install -e default && pixi clean cache --yes

# 2) Código del workflow
COPY . .

# Comando por defecto: tutorial (Bélgica, 1 semana, HiGHS). Se sobreescribe con la variable SNAKE_TARGET/SNAKE_CONFIG
ENV SNAKE_TARGET=results/test-elec/networks/solved_2050.nc \
    SNAKE_CONFIG=config/test/config.electricity.yaml \
    SNAKE_CORES=all \
    SNAKE_EXTRA=""

CMD ["bash", "-lc", "pixi run -e default snakemake --cores $SNAKE_CORES $SNAKE_TARGET --configfile $SNAKE_CONFIG --rerun-incomplete $SNAKE_EXTRA"]
