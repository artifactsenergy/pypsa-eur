# Imagen para ejecutar PyPSA-Eur en Railway como job batch
FROM ghcr.io/prefix-dev/pixi:0.81.0

RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates bash git python3 python3-boto3 && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

# 1) Entorno (capa cacheable): solo pixi.toml / pixi.lock
COPY pixi.toml pixi.lock ./
RUN pixi install -e default && pixi clean cache --yes
# HiPO (punto interior paralelo de HiGHS): highspy >= 1.15.1 + highspy-extras (Apache 2.0). Se instala con pip
# encima del entorno pixi y se comprueba en la construcción que HiPO está disponible.
# Activación del entorno sin `pixi run`: pixi run resincroniza el entorno con pixi.lock en cada llamada y
# deshace el highspy instalado con pip (en el primer intento volvió a 1.13.1). El job usa este script.
RUN pixi shell-hook -e default > /opt/pixi_activar.sh
RUN pixi run -e default python -m ensurepip --upgrade && \
    pixi run -e default python -m pip install --no-cache-dir "highspy>=1.15.1" "highspy-extras>=1.15.1" && \
    pixi run -e default python -c "import highspy, highspy_extras; from importlib.metadata import version as v; print('highspy', v('highspy'), 'extras', v('highspy-extras'))" && \
    bash -c "source /opt/pixi_activar.sh && python -c \"from importlib.metadata import version as v; assert v('highspy')>='1.15', v('highspy'); print('activado: highspy', v('highspy'))\""

# 2) Código del workflow
COPY . .

# Comando por defecto: tutorial (Bélgica, 1 semana, HiGHS). Se sobreescribe con la variable SNAKE_TARGET/SNAKE_CONFIG
ENV SNAKE_TARGET=results/test-elec/networks/solved_2050.nc \
    SNAKE_CONFIG=config/test/config.electricity.yaml \
    SNAKE_CORES=all \
    SNAKE_EXTRA=""

# v0.62 de EDGE: railway/job.sh. Con PAQUETE_KEY (lanzado desde EDGE) usa los supuestos comunes del escenario;
# sin él ejecuta el snakemake de SNAKE_* como antes. El servicio de Railway NO debe tener Custom Start Command.
CMD ["bash", "railway/job.sh"]
